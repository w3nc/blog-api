# --- Database ---------------------------------------------------------------
# Local Postgres. Change the port/user/password to match your install.
# On a PaaS (Railway, Render, Neon, Supabase) paste the URL the dashboard gives you,
# and add ?sslmode=require if the provider asks for it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/blog_api?schema=public"

# --- Server -----------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Comma-separated list of front-end origins allowed to call this API.
# The browser sends an OPTIONS "preflight" request first because we use the
# Authorization header, and CORS must answer that too.
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174"

# --- Auth -------------------------------------------------------------------
# Use a long random string in production, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Password given to the author account created by `npm run db:seed`.
# Username is always "maria" (see prisma/seed.js).
SEED_AUTHOR_PASSWORD="maria1234"
